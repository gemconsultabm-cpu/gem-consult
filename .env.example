# ---- GEM Consult : copier ce fichier en « .env » puis compléter ----
# Port local sur lequel nginx joindra le site (choisir un port libre si l'ancien site utilise 3000)
WEB_PORT=3010
# Adresse publique du site (métadonnées, plan du site)
SITE_URL=https://gemabm.com
# Secret partagé entre le planificateur et le site — générer avec : openssl rand -hex 32
CRON_SECRET=
# ---- Facultatif : ces réglages peuvent aussi être saisis dans https://gemabm.com/admin ----
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_WORKSPACE_ID=wrkspc_...   (obligatoire pour une clé « sk-ant-usr- »)
# SMTP_HOST=ssl0.ovh.net
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=site@gemabm.com
# SMTP_PASS=
# MAIL_TO=contact@gemabm.com
# MAIL_FROM=site@gemabm.com
# Modèles Claude (par défaut : claude-sonnet-5-5 et claude-haiku-5-5)
# GEM_MODEL=claude-sonnet-5-5
# GEM_MODEL_FAST=claude-haiku-5-5
